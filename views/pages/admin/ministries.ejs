<section>
  <% var rs = locals.listState ? '?return=' + encodeURIComponent(listState) : ''; %>
  <div class="admin-bar">
    <h1 class="page-title">Ministries</h1>
    <span class="admin-bar-actions">
      <a class="btn btn-ghost" href="/ministries" target="_blank" rel="noopener">View page&nbsp;&nearr;</a>
      <a class="btn btn-gold" href="/admin/ministries/new<%= rs %>" data-shortcut-new>Add New</a>
    </span>
  </div>

  <%- include('./_flash') %>

  <%- include('./_search') %>

  <% if (rows && rows.length) { %>
    <table class="admin-table">
      <thead>
        <tr>
          <%- include('./_sort', { key: 'name', label: 'Name' }) %>
          <%- include('./_sort', { key: 'leader', label: 'Leader' }) %>
          <th>Contact</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% rows.forEach(function (r) { %>
          <tr>
            <td data-label="Name"><%= r.name %></td>
            <td data-label="Leader"><%= r.leader || '' %></td>
            <td data-label="Contact"><%= r.contact_email || '' %></td>
            <td class="row-actions">
              <a class="btn btn-outline btn-sm" href="/admin/ministries/<%= r.id %>/edit<%= rs %>">Edit</a>
              <a class="btn btn-line-danger btn-sm" href="/admin/ministries/<%= r.id %>/delete<%= rs %>">Delete</a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>

    <%- include('./_pagination', { base: '/admin/ministries', page: page, totalPages: totalPages }) %>
  <% } else { %>
    <p class="empty"><%= locals.q ? 'No ministries match your search.' : 'No ministries yet.' %></p>
  <% } %>
</section>
