<section class="page-head page-head--rule">
  <div class="container">
    <p class="eyebrow">Get involved</p>
    <h1 class="page-title">Ministries</h1>
    <p class="lede">There is a place for everyone to serve, grow, and belong. Explore the ministries of our church family and find where you are called to take part.</p>
  </div>
</section>

<section class="section reveal">
  <div class="container">
    <% if (ministries && ministries.length) { %>
      <div class="card-grid reveal-group">
        <% ministries.forEach(function (m) { %>
          <div class="card">
            <div class="thumb skeleton">
              <img class="thumb-img" loading="lazy" src="<%= m.image_url ? m.image_url : '/images/church-logo-placeholder.png' %>" alt="<%= m.name %>" data-fallback="/images/church-logo-placeholder.png" />
            </div>
            <div class="card-body">
              <h3 class="card-title"><%= m.name %></h3>
              <% if (m.description) { %><p class="card-bio"><%= m.description %></p><% } %>
              <% if (m.leader) { %><p class="card-meta card-meta--caps">Led by <%= m.leader %></p><% } %>
              <% if (m.contact_email) { %>
                <p class="card-meta"><a class="content-link" href="mailto:<%= m.contact_email %>"><%= m.contact_email %></a></p>
              <% } %>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <p class="empty">Ministry information coming soon</p>
    <% } %>
  </div>
</section>
