<section>
  <div class="admin-bar">
    <h1 class="page-title">Events</h1>
    <a class="btn btn-gold" href="/admin/events/new">Add New</a>
  </div>

  <% if (query && query.success) { %><p class="flash flash-success">Saved successfully</p><% } %>
  <% if (query && query.error) { %><p class="flash flash-error">There was a problem with that request</p><% } %>

  <% if (rows && rows.length) { %>
    <table class="admin-table">
      <thead>
        <tr><th>Title</th><th>Date</th><th>Time</th><th>Location</th><th>Actions</th></tr>
      </thead>
      <tbody>
        <% rows.forEach(function (r) { %>
          <tr>
            <td><%= r.title %></td>
            <td><%= fmtDate(r.date) %></td>
            <td><%= r.time ? fmtTime(r.time) : '' %></td>
            <td><%= r.location || '' %></td>
            <td class="row-actions">
              <a class="btn btn-outline btn-sm" href="/admin/events/<%= r.id %>/edit">Edit</a>
              <a class="btn btn-danger btn-sm" href="/admin/events/<%= r.id %>/delete">Delete</a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>

    <%- include('./_pagination', { base: '/admin/events', page: page, totalPages: totalPages }) %>
  <% } else { %>
    <p class="empty">No events yet.</p>
  <% } %>
</section>
