# ──────────────────────────────────────────────────────────────────────────
# Church Website — environment variables
# Copy to .env for local dev, or set each in the Railway dashboard.
# There is NO SESSION_SECRET — this stack uses no session middleware.
# ──────────────────────────────────────────────────────────────────────────

# Port the server listens on (Railway injects this automatically)
PORT=3000

# PostgreSQL connection string (Railway PostgreSQL addon provides this)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# JWT signing secret — MINIMUM 32 chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_64_hex_chars_minimum_32_characters_long

# CSRF token HMAC secret — MINIMUM 32 chars, must differ from JWT_SECRET. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CSRF_SECRET=replace_with_64_hex_chars_minimum_32_characters_long

# Backup bearer token — MINIMUM 64 chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
BACKUP_SECRET=replace_with_128_hex_chars_minimum_64_characters_long_value_here

# Where weekly JSON backups are emailed
BACKUP_EMAIL=admin@TMPCfamily.net

# Where the public contact form delivers messages
CHURCH_CONTACT_EMAIL=office@TMPCfamily.net

# Resend transactional email API key (https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Cloudinary image hosting (https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=000000000000000
CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Seeded on first migration if the admins table is empty
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASSWORD=change_this_to_a_strong_password_min_12

# One-time password reset token (set when needed, remove after use)
ADMIN_RESET_TOKEN=set_only_when_performing_a_reset

# OPTIONAL — canonical origin for SEO (canonical links, Open Graph, sitemap).
# If unset it is derived from each request's Host header, which is fine.
# Set in production so search engines always see one origin. With GoDaddy →
# Railway the canonical host is www (GoDaddy forwards the apex to www, which is
# CNAME'd to Railway); the app 301s any bare-apex hit to this host too:
# SITE_URL=https://www.tmpcfamily.net

# OPTIONAL — hours between automatic database backups. Defaults to 24 in
# production and 0 (disabled) elsewhere. Set to 0 to turn scheduled backups off.
# AUTO_BACKUP_HOURS=24
