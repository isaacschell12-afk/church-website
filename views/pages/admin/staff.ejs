<section>
  <div class="admin-bar">
    <h1 class="page-title">Staff</h1>
    <a class="btn btn-gold" href="/admin/staff/new">Add New</a>
  </div>

  <% if (query && query.success) { %><p class="flash flash-success">Saved successfully</p><% } %>
  <% if (query && query.error) { %><p class="flash flash-error">There was a problem with that request</p><% } %>

  <% if (rows && rows.length) { %>
    <table class="admin-table">
      <thead>
        <tr><th>Order</th><th>Name</th><th>Title</th><th>Actions</th></tr>
      </thead>
      <tbody>
        <% rows.forEach(function (r, i) { %>
          <tr>
            <td class="order-cell">
              <form class="inline-form" method="POST" action="/admin/staff/<%= r.id %>/move">
                <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>" />
                <input type="hidden" name="direction" value="up" />
                <button type="submit" class="btn btn-outline btn-sm" <%= i === 0 ? 'disabled' : '' %>>&uarr;</button>
              </form>
              <form class="inline-form" method="POST" action="/admin/staff/<%= r.id %>/move">
                <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>" />
                <input type="hidden" name="direction" value="down" />
                <button type="submit" class="btn btn-outline btn-sm" <%= i === rows.length - 1 ? 'disabled' : '' %>>&darr;</button>
              </form>
            </td>
            <td><%= r.name %></td>
            <td><%= r.title || '' %></td>
            <td class="row-actions">
              <a class="btn btn-outline btn-sm" href="/admin/staff/<%= r.id %>/edit">Edit</a>
              <a class="btn btn-danger btn-sm" href="/admin/staff/<%= r.id %>/delete">Delete</a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } else { %>
    <p class="empty">No staff yet.</p>
  <% } %>
</section>
