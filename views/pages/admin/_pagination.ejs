<%
  var pgState = new URLSearchParams();
  if (locals.q) pgState.set('q', q);
  if (locals.sort) pgState.set('sort', sort);
  var pgQ = pgState.toString() ? '&' + pgState.toString() : '';
%>
<% if (totalPages > 1) { %>
  <nav class="pagination" aria-label="Pagination">
    <% if (page > 1) { %>
      <a class="btn btn-outline" href="<%= base %>?page=<%= page - 1 %><%- pgQ %>">Previous</a>
    <% } else { %>
      <span class="btn btn-outline is-disabled">Previous</span>
    <% } %>
    <span class="page-indicator">Page <%= page %> of <%= totalPages %></span>
    <% if (page < totalPages) { %>
      <a class="btn btn-outline" href="<%= base %>?page=<%= page + 1 %><%- pgQ %>">Next</a>
    <% } else { %>
      <span class="btn btn-outline is-disabled">Next</span>
    <% } %>
  </nav>
<% } %>
