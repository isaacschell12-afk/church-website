<section class="reveal">
  <p class="eyebrow">You are welcome here</p>
  <h1 class="page-title">Plan a Visit</h1>
  <p class="lede">However you found us, whatever questions you bring, there's a place for you in the pew this Sunday.</p>

  <% if (query && query.success) { %>
    <p class="flash flash-success">Thank you &mdash; we're so glad you're coming. We'll be in touch soon.</p>
  <% } %>
  <% if (query && query.error) { %>
    <p class="flash flash-error">Something went wrong &mdash; please email us directly at <%= church && church.email ? church.email : '' %></p>
  <% } %>
</section>

<section class="reveal">
  <div class="contact-grid">
    <div class="contact-info">
      <p class="eyebrow">Before you come</p>
      <h2 class="section-title">What to expect</h2>

      <% if (church && church.visit_info) { %>
        <p class="prose prose-prewrap"><%= church.visit_info %></p>
      <% } else { %>
        <p class="empty">Visit details coming soon.</p>
      <% } %>

      <% if ((church && church.service_times) || (church && church.address)) { %>
        <hr class="rule" />
      <% } %>

      <% if (church && church.service_times) { %>
        <p class="prose prose-prewrap"><strong>Service Times</strong><br /><%= church.service_times %></p>
      <% } %>
      <% if (church && church.address) { %>
        <p class="prose"><strong>Where to find us</strong><br /><%= church.address %></p>
      <% } %>
    </div>

    <div>
      <p class="eyebrow">Say hello first</p>
      <h2 class="section-title">Let us know you're coming</h2>
      <p class="prose">Tell us a little about yourself and we'll have someone ready to welcome you.</p>
      <form class="contact-form" method="POST" action="/contact">
        <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>" />
        <input type="hidden" name="source" value="Planning a visit" />

        <label for="name">Name</label>
        <input type="text" id="name" name="name" maxlength="100" required />

        <label for="email">Email</label>
        <input type="email" id="email" name="email" maxlength="200" required />

        <label for="message">Anything we should know? (optional details, kids' ages, questions)</label>
        <textarea id="message" name="message" maxlength="2000" rows="5" required></textarea>

        <!-- Honeypot: hidden from real users via CSS (.hp-field). Bots that fill it are rejected. -->
        <input type="text" class="hp-field" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />

        <button type="submit" class="btn btn-navy">I'm Planning to Visit</button>
      </form>
    </div>
  </div>
</section>

<% if (church && church.maps_embed_url) { %>
  <section class="reveal">
    <p class="eyebrow">Find your way</p>
    <h2 class="section-title">Getting here</h2>
    <div class="map-embed">
      <iframe class="map-frame" src="<%= church.maps_embed_url %>" title="Map" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>
  </section>
<% } %>
