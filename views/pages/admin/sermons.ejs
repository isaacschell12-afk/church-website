<section>
  <div class="admin-bar">
    <h1 class="page-title">Sermons</h1>
    <a class="btn btn-gold" href="/admin/sermons/new">Add New</a>
  </div>

  <% if (query && query.success) { %><p class="flash flash-success">Saved successfully</p><% } %>
  <% if (query && query.error) { %><p class="flash flash-error">There was a problem with that request</p><% } %>

  <%- include('./_search') %>

  <% if (rows && rows.length) { %>
    <table class="admin-table">
      <thead>
        <tr><th>Title</th><th>Date</th><th>Pastor</th><th>Actions</th></tr>
      </thead>
      <tbody>
        <% rows.forEach(function (r) { %>
          <tr>
            <td data-label="Title"><%= r.title %></td>
            <td data-label="Date"><%= fmtDate(r.date) %></td>
            <td data-label="Pastor"><%= r.pastor %></td>
            <td class="row-actions">
              <a class="btn btn-outline btn-sm" href="/admin/sermons/<%= r.id %>/edit">Edit</a>
              <a class="btn btn-outline btn-sm" href="/admin/sermons/<%= r.id %>/duplicate">Duplicate</a>
              <a class="btn btn-line-danger btn-sm" href="/admin/sermons/<%= r.id %>/delete">Delete</a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>

    <%- include('./_pagination', { base: '/admin/sermons', page: page, totalPages: totalPages }) %>
  <% } else { %>
    <p class="empty"><%= locals.q ? 'No sermons match your search.' : 'No sermons yet.' %></p>
  <% } %>
</section>
