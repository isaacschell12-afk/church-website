<section class="page-head page-head--rule">
  <div class="container">
    <p class="eyebrow">Gather</p>
    <h1 class="page-title">Events</h1>
    <p class="lede">Mark your calendar and join us. Here is what is coming up in the life of our church.</p>
    <p class="card-meta"><a href="/events.ics">Subscribe to our calendar &rarr;</a></p>
  </div>
</section>

<section class="section reveal">
  <div class="container">
    <% if (events && events.length) { %>
      <div class="card-grid reveal-group">
        <% events.forEach(function (e) { %>
          <% var dp = (fmtDate(e.date) || '').replace(',', '').split(' '); %>
          <a class="card card--event event-card" href="/events/<%= e.id %>">
            <div class="card-body">
              <% if (dp.length >= 2) { %>
                <span class="date-block" aria-hidden="true">
                  <span class="date-block__mon"><%= dp[0].slice(0, 3) %></span>
                  <span class="date-block__day"><%= dp[1] %></span>
                </span>
              <% } %>
              <div class="card-main">
                <h3 class="card-title"><%= e.title %></h3>
                <p class="card-meta"><%= fmtDate(e.date) %><% if (e.time) { %> &middot; <%= fmtTime(e.time) %><% } %></p>
                <% if (e.location) { %><p class="card-meta"><%= e.location %></p><% } %>
                <% if (e.description) { %><p class="card-bio card-bio-clamp"><%= e.description %></p><% } %>
                <span class="card-link next-step-arrow">Details &rarr;</span>
              </div>
            </div>
          </a>
        <% }) %>
      </div>
    <% } else { %>
      <p class="empty">No upcoming events — check back soon.</p>
    <% } %>
  </div>
</section>
