<section>
  <% var backQs = locals.returnState ? '?' + returnState : ''; %>
  <a class="content-link back-link" href="/admin/events<%= backQs %>">&larr; Back to events</a>
  <h1 class="page-title"><%= mode === 'edit' ? 'Edit Event' : 'New Event' %></h1>

  <% if (query && query.success) { %><p class="flash flash-success">Saved — add the next one below</p><% } %>
  <% if (query && query.error) { %><p class="flash flash-error">Please check the fields and try again</p><% } %>

  <form class="admin-form" method="POST" action="<%= mode === 'edit' ? '/admin/events/' + record.id : '/admin/events' %>">
    <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>" />
    <input type="hidden" name="return_to" value="<%= locals.returnState || '' %>" />
    <% if (mode === 'edit') { %>
      <input type="hidden" name="last_modified" value="<%= record.last_modified || '' %>" />
    <% } %>

    <label for="title">Title</label>
    <input type="text" id="title" name="title" maxlength="200" value="<%= record.title || '' %>" required />

    <label for="date">Date</label>
    <input type="date" id="date" name="date" value="<%= record.date || '' %>" required />

    <label for="time">Time</label>
    <input type="time" id="time" name="time" value="<%= record.time ? String(record.time).slice(0,5) : '' %>" />

    <label for="location">Location</label>
    <input type="text" id="location" name="location" maxlength="200" value="<%= record.location || '' %>" />

    <label for="description">Description</label>
    <textarea id="description" name="description" rows="6" maxlength="10000"><%= record.description || '' %></textarea>

    <div class="btn-row">
      <button type="submit" class="btn btn-navy">Save</button>
      <% if (mode === 'new') { %>
        <button type="submit" class="btn btn-outline" name="after" value="another">Save &amp; add another</button>
      <% } %>
    </div>
  </form>
</section>
