<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <%
    var siteName = church && church.church_name ? church.church_name : 'Our Church';
    var rawTitle = typeof title !== 'undefined' && title ? title : 'Church';
    var pageTitle = rawTitle === siteName ? siteName : rawTitle + ' — ' + siteName;
    var pageDesc = (locals.metaDescription && String(metaDescription).trim())
      || (siteName + (church && church.tagline ? ' — ' + church.tagline : ''));
    var isAdminPath = !!(locals.reqPath && reqPath.indexOf('/admin') === 0);
    var pageUrl = (locals.baseUrl || '') + (locals.reqPath || '/');
  %>
  <title><%= pageTitle %></title>
  <meta name="description" content="<%= pageDesc %>" />
  <% if (isAdminPath) { %>
  <meta name="robots" content="noindex, nofollow" />
  <% } else { %>
  <link rel="canonical" href="<%= pageUrl %>" />
  <meta property="og:site_name" content="<%= siteName %>" />
  <meta property="og:type" content="<%= locals.ogType || 'website' %>" />
  <meta property="og:title" content="<%= pageTitle %>" />
  <meta property="og:description" content="<%= pageDesc %>" />
  <meta property="og:url" content="<%= pageUrl %>" />
  <% var shareImage = locals.ogImage || (church && church.logo_url) || null; %>
  <% if (shareImage) { %>
  <meta property="og:image" content="<%= shareImage %>" />
  <% } %>
  <meta name="twitter:card" content="<%= locals.ogImage ? 'summary_large_image' : 'summary' %>" />
  <link rel="alternate" type="application/rss+xml" title="<%= siteName %> — Sermons" href="<%= (locals.baseUrl || '') %>/sermons/feed.xml" />
  <% } %>
  <meta name="csrf-token" content="<%= locals.csrfToken || '' %>" />
  <link rel="icon" href="<%= church && church.favicon_url ? church.favicon_url : '/images/favicon.ico' %>" />
  <link rel="icon" type="image/png" sizes="192x192" href="/images/icon-192.png" />
  <link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#16233F" />
  <link rel="preload" as="font" type="font/woff2" href="/css/fonts/fraunces-600.woff2" crossorigin />
  <link rel="preload" as="font" type="font/woff2" href="/css/fonts/fraunces-400-italic.woff2" crossorigin />
  <link rel="preload" as="font" type="font/woff2" href="/css/fonts/inter-400.woff2" crossorigin />
  <link rel="stylesheet" href="/css/main.css?v=<%= locals.assetV || '0' %>" />
  <% if (!isAdminPath && church) {
    /* schema.org Church structured data — feeds "churches near me" search results.
       A JSON-LD script is a data block, not executable, so the CSP does not apply. */
    var churchLd = {
      '@context': 'https://schema.org',
      '@type': 'Church',
      name: siteName,
      url: (locals.baseUrl || '') + '/',
    };
    if (church.address) churchLd.address = church.address;
    if (church.phone) churchLd.telephone = church.phone;
    if (church.email) churchLd.email = church.email;
    if (church.logo_url) churchLd.logo = church.logo_url;
    if (church.tagline) churchLd.slogan = church.tagline;
  %>
  <script type="application/ld+json"><%- JSON.stringify(churchLd).replace(/</g, '\\u003c') %></script>
  <% } %>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>

  <% if (locals.admin) { %>
    <%- include('../pages/admin/_nav') %>
  <% } else { %>
    <header class="site-header" data-site-header>
      <div class="container nav-bar">
        <a class="brand" href="/">
          <% if (church && church.logo_url) { %>
            <img class="brand-logo" src="<%= imgOpt(church.logo_url, 400) %>" alt="<%= church.church_name %>" data-fallback="/images/church-logo-placeholder.png" />
          <% } else { %>
            <span class="brand-name"><%= church && church.church_name ? church.church_name : 'Our Church' %></span>
          <% } %>
        </a>
        <button class="nav-toggle" aria-label="Toggle navigation" aria-controls="primary-nav" aria-expanded="false" data-nav-toggle>
          <span class="nav-toggle-bar"></span>
          <span class="nav-toggle-bar"></span>
          <span class="nav-toggle-bar"></span>
        </button>
        <nav class="main-nav" id="primary-nav" aria-label="Primary" data-nav>
          <a href="/">Home</a>
          <a href="/about">About</a>
          <a href="/sunday-school">Sunday School</a>
          <a href="/ministries">Ministries</a>
          <a href="/sermons">Sermons</a>
          <a href="/events">Events</a>
          <span class="nav-cta">
            <a class="btn btn-gold btn-sm" href="/visit">Plan a Visit</a>
            <a class="btn btn-line-gold btn-sm" href="/give">Give</a>
          </span>
        </nav>
      </div>
    </header>
  <% } %>

  <main id="main" class="page<%= locals.admin ? ' container admin' : '' %>">
    <%- include(bodyPath) %>
  </main>

  <% if (!locals.admin) { %>
    <footer class="site-footer">
      <div class="container">
        <% if (church && church.tagline) { %>
          <p class="footer-statement"><%= church.tagline %></p>
        <% } %>
        <div class="footer-grid">
          <div>
            <h2 class="footer-heading"><%= church && church.church_name ? church.church_name : 'Our Church' %></h2>
            <p><a href="/visit">Plan a visit &rarr;</a></p>
            <p><a href="/beliefs">What we believe &rarr;</a></p>
            <p><a href="/give">Give online &rarr;</a></p>
          </div>
          <div>
            <h2 class="footer-heading">Visit</h2>
            <% if (church && church.address) { %><p><%= church.address %></p><% } %>
            <% if (church && church.service_times) { %><p class="prose-prewrap"><%= church.service_times %></p><% } %>
          </div>
          <div>
            <h2 class="footer-heading">Connect</h2>
            <% if (church && church.phone) { %><p><%= church.phone %></p><% } %>
            <% if (church && church.email) { %><p><a href="mailto:<%= church.email %>"><%= church.email %></a></p><% } %>
            <p><a href="/contact">Send a message &rarr;</a></p>
          </div>
        </div>
        <p class="footer-bottom">&copy; <%= church && church.church_name ? church.church_name : 'Our Church' %></p>
      </div>
    </footer>
  <% } %>

  <script src="/js/admin.js?v=<%= locals.assetV || '0' %>"></script>
</body>
</html>
