<section class="page-head page-head--rule">
  <div class="container">
    <p class="eyebrow">Messages</p>
    <h1 class="page-title">Sermons</h1>
    <p class="lede">Revisit recent teaching and dig into the Scriptures with us. Search the archive by title or by the pastor who brought the message.</p>

    <form class="search-form" method="GET" action="/sermons">
      <label for="sermon-search" class="sr-only">Search sermons by title or pastor</label>
      <input type="text" id="sermon-search" name="search" value="<%= search %>" placeholder="Search by title or pastor" />
      <input type="hidden" name="page" value="1" />
      <button type="submit" class="btn btn-navy">Search</button>
    </form>
  </div>
</section>

<section class="section reveal">
  <div class="container">
    <% if (sermons && sermons.length) { %>
      <div class="card-grid reveal-group">
        <% sermons.forEach(function (s) { %>
          <a class="card sermon-card" href="/sermons/<%= s.id %>">
            <div class="thumb skeleton">
              <img class="thumb-img" loading="lazy" src="https://img.youtube.com/vi/<%= s.youtube_id %>/hqdefault.jpg" alt="<%= s.title %>" data-fallback="/images/church-logo-placeholder.png" />
            </div>
            <div class="card-body">
              <h3 class="card-title"><%= s.title %></h3>
              <p class="card-meta card-meta--caps"><%= s.pastor %></p>
              <p class="card-meta"><%= fmtDate(s.date) %></p>
            </div>
          </a>
        <% }) %>
      </div>

      <% if (totalPages > 1) { %>
        <nav class="pagination" aria-label="Pagination">
          <% if (page > 1) { %>
            <a class="btn btn-outline" href="/sermons?search=<%= encodeURIComponent(search) %>&page=<%= page - 1 %>">Previous</a>
          <% } else { %>
            <span class="btn btn-outline is-disabled">Previous</span>
          <% } %>
          <span class="page-indicator">Page <%= page %> of <%= totalPages %></span>
          <% if (page < totalPages) { %>
            <a class="btn btn-outline" href="/sermons?search=<%= encodeURIComponent(search) %>&page=<%= page + 1 %>">Next</a>
          <% } else { %>
            <span class="btn btn-outline is-disabled">Next</span>
          <% } %>
        </nav>
      <% } %>
    <% } else { %>
      <% if (search) { %>
        <p class="empty">No sermons match your search — try a different title or pastor.</p>
      <% } else { %>
        <p class="empty">No sermons yet — check back soon.</p>
      <% } %>
    <% } %>
  </div>
</section>
