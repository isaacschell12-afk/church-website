<section>
  <% var rs = locals.listState ? '?return=' + encodeURIComponent(listState) : ''; %>
  <div class="admin-bar">
    <h1 class="page-title">Events</h1>
    <a class="btn btn-gold" href="/admin/events/new<%= rs %>" data-shortcut-new>Add New</a>
  </div>

  <%- include('./_flash') %>

  <%- include('./_search') %>

  <% if (rows && rows.length) { %>
    <table class="admin-table">
      <thead>
        <tr>
          <%- include('./_sort', { key: 'title', label: 'Title' }) %>
          <%- include('./_sort', { key: 'date', label: 'Date' }) %>
          <th>Time</th>
          <%- include('./_sort', { key: 'location', label: 'Location' }) %>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% rows.forEach(function (r) { %>
          <tr>
            <td data-label="Title"><%= r.title %></td>
            <td data-label="Date"><%= fmtDate(r.date) %></td>
            <td data-label="Time"><%= r.time ? fmtTime(r.time) : '' %></td>
            <td data-label="Location"><%= r.location || '' %></td>
            <td class="row-actions">
              <a class="btn btn-outline btn-sm" href="/admin/events/<%= r.id %>/edit<%= rs %>">Edit</a>
              <a class="btn btn-outline btn-sm" href="/admin/events/<%= r.id %>/duplicate<%= rs %>">Duplicate</a>
              <a class="btn btn-ghost btn-sm" href="/events/<%= r.id %>" target="_blank" rel="noopener">View&nbsp;&nearr;</a>
              <a class="btn btn-line-danger btn-sm" href="/admin/events/<%= r.id %>/delete<%= rs %>">Delete</a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>

    <%- include('./_pagination', { base: '/admin/events', page: page, totalPages: totalPages }) %>
  <% } else { %>
    <p class="empty"><%= locals.q ? 'No events match your search.' : 'No events yet.' %></p>
  <% } %>
</section>
