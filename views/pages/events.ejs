<section class="reveal">
  <div class="section-head">
    <div>
      <p class="eyebrow">Gather</p>
      <h1 class="page-title">Events</h1>
    </div>
  </div>

  <p class="lede">Mark your calendar and join us. Here is what is coming up in the life of our church.</p>

  <hr class="rule" />

  <% if (events && events.length) { %>
    <div class="card-grid reveal-group">
      <% events.forEach(function (e) { %>
        <a class="card event-card" href="/events/<%= e.id %>">
          <div class="card-body">
            <h3 class="card-title"><%= e.title %></h3>
            <p class="card-meta"><%= fmtDate(e.date) %><% if (e.time) { %> · <%= fmtTime(e.time) %><% } %></p>
            <% if (e.location) { %><p class="card-meta"><%= e.location %></p><% } %>
            <% if (e.description) { %><p class="card-bio card-bio-clamp"><%= e.description %></p><% } %>
            <span class="card-link next-step-arrow">Details &rarr;</span>
          </div>
        </a>
      <% }) %>
    </div>
  <% } else { %>
    <p class="empty">No upcoming events — check back soon.</p>
  <% } %>
</section>
