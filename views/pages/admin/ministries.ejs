<section>
  <div class="admin-bar">
    <h1 class="page-title">Ministries</h1>
    <a class="btn btn-gold" href="/admin/ministries/new">Add New</a>
  </div>

  <% if (query && query.success) { %><p class="flash flash-success">Saved successfully</p><% } %>
  <% if (query && query.error) { %><p class="flash flash-error">There was a problem with that request</p><% } %>

  <% if (rows && rows.length) { %>
    <table class="admin-table">
      <thead>
        <tr><th>Name</th><th>Leader</th><th>Contact</th><th>Actions</th></tr>
      </thead>
      <tbody>
        <% rows.forEach(function (r) { %>
          <tr>
            <td data-label="Name"><%= r.name %></td>
            <td data-label="Leader"><%= r.leader || '' %></td>
            <td data-label="Contact"><%= r.contact_email || '' %></td>
            <td class="row-actions">
              <a class="btn btn-outline btn-sm" href="/admin/ministries/<%= r.id %>/edit">Edit</a>
              <a class="btn btn-line-danger btn-sm" href="/admin/ministries/<%= r.id %>/delete">Delete</a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>

    <%- include('./_pagination', { base: '/admin/ministries', page: page, totalPages: totalPages }) %>
  <% } else { %>
    <p class="empty">No ministries yet.</p>
  <% } %>
</section>
