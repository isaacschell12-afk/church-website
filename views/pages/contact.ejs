<section class="page-head page-head--rule">
  <div class="container">
    <p class="eyebrow">Get in touch</p>
    <h1 class="page-title">Contact</h1>
    <p class="lede">We would love to hear from you. Send a message, find our service times, or visit us in person.</p>

    <% if (query && query.success) { %>
      <p class="flash flash-success">Thank you &mdash; we will be in touch soon.</p>
    <% } %>
    <% if (query && query.error) { %>
      <p class="flash flash-error">Something went wrong &mdash; please email us directly at <%= church && church.email ? church.email : '' %></p>
    <% } %>
  </div>
</section>

<section class="section reveal">
  <div class="container">
    <div class="contact-grid">
      <div class="contact-info">
        <% if (church && church.address) { %>
          <p><strong>Address</strong><%= church.address %></p>
        <% } %>
        <% if (church && church.phone) { %>
          <p><strong>Phone</strong><%= church.phone %></p>
        <% } %>
        <% if (church && church.email) { %>
          <p><strong>Email</strong><a class="content-link" href="mailto:<%= church.email %>"><%= church.email %></a></p>
        <% } %>
        <% if (church && church.service_times) { %>
          <p><strong>Service Times</strong><span class="prose-prewrap"><%= church.service_times %></span></p>
        <% } %>
      </div>

      <div>
        <p class="eyebrow">Send a message</p>
        <h2 class="section-title">We read every note</h2>
        <form class="contact-form" method="POST" action="/contact">
        <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>" />

        <label for="name">Name</label>
        <input type="text" id="name" name="name" maxlength="100" required />

        <label for="email">Email</label>
        <input type="email" id="email" name="email" maxlength="200" required />

        <label for="message">Message</label>
        <textarea id="message" name="message" maxlength="2000" rows="6" required></textarea>

        <!-- Honeypot: hidden from real users via CSS (.hp-field). Bots that fill it are rejected. -->
        <input type="text" class="hp-field" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />

        <button type="submit" class="btn btn-navy">Send Message</button>
        </form>
      </div>
    </div>
  </div>
</section>

<% if (church && church.maps_embed_url) { %>
  <section class="section section--flush-top reveal" aria-label="Map">
    <div class="container">
      <div class="map-embed">
        <iframe class="map-frame" src="<%= church.maps_embed_url %>" title="Map" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
    </div>
  </section>
<% } %>
