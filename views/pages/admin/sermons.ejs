<section>
  <% var rs = locals.listState ? '?return=' + encodeURIComponent(listState) : ''; %>
  <div class="admin-bar">
    <h1 class="page-title">Sermons</h1>
    <a class="btn btn-gold" href="/admin/sermons/new<%= rs %>" data-shortcut-new>Add New</a>
  </div>

  <%- include('./_flash') %>

  <%- include('./_search') %>

  <% if (rows && rows.length) { %>
    <table class="admin-table">
      <thead>
        <tr>
          <%- include('./_sort', { key: 'title', label: 'Title' }) %>
          <%- include('./_sort', { key: 'date', label: 'Date' }) %>
          <%- include('./_sort', { key: 'pastor', label: 'Pastor' }) %>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% rows.forEach(function (r) { %>
          <tr>
            <td data-label="Title"><%= r.title %></td>
            <td data-label="Date"><%= fmtDate(r.date) %></td>
            <td data-label="Pastor"><%= r.pastor %></td>
            <td class="row-actions">
              <a class="btn btn-outline btn-sm" href="/admin/sermons/<%= r.id %>/edit<%= rs %>">Edit</a>
              <a class="btn btn-outline btn-sm" href="/admin/sermons/<%= r.id %>/duplicate<%= rs %>">Duplicate</a>
              <a class="btn btn-ghost btn-sm" href="/sermons/<%= r.id %>" target="_blank" rel="noopener">View&nbsp;&nearr;</a>
              <a class="btn btn-line-danger btn-sm" href="/admin/sermons/<%= r.id %>/delete<%= rs %>">Delete</a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>

    <%- include('./_pagination', { base: '/admin/sermons', page: page, totalPages: totalPages }) %>
  <% } else { %>
    <p class="empty"><%= locals.q ? 'No sermons match your search.' : 'No sermons yet.' %></p>
  <% } %>
</section>
