<section class="page-head page-head--rule">
  <div class="container container--narrow">
    <p class="eyebrow">Our faith</p>
    <h1 class="page-title">What We Believe</h1>
    <p class="lede">The convictions that shape our worship, our teaching, and our life together.</p>
  </div>
</section>

<section class="section reveal">
  <div class="container container--narrow">
    <% if (church && church.statement_of_faith) { %>
      <div class="prose"><%- include('_prose-blocks', { text: church.statement_of_faith, headTag: 'h2' }) %></div>
    <% } else { %>
      <p class="empty">Our statement of faith is coming soon.</p>
    <% } %>
  </div>
</section>

<section class="section section--tint give-cta reveal">
  <div class="container">
    <p class="eyebrow">Come and see</p>
    <h2 class="section-title">We would love to meet you</h2>
    <p class="prose">If these beliefs resonate with you, the best next step is simply to join us in person.</p>
    <a class="btn btn-gold" href="/visit">Plan your visit &rarr;</a>
  </div>
</section>
