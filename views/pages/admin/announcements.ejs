<section>
  <div class="admin-bar">
    <h1 class="page-title">Announcements</h1>
    <a class="btn btn-gold" href="/admin/announcements/new">Add New</a>
  </div>

  <% if (query && query.success) { %><p class="flash flash-success">Saved successfully</p><% } %>
  <% if (query && query.error) { %><p class="flash flash-error">There was a problem with that request</p><% } %>

  <% if (rows && rows.length) { %>
    <table class="admin-table">
      <thead>
        <tr><th>Message</th><th>Active</th><th>Expires (UTC)</th><th>Actions</th></tr>
      </thead>
      <tbody>
        <% rows.forEach(function (r) { %>
          <tr>
            <td><%= r.message %></td>
            <td><%= r.active ? 'Yes' : 'No' %></td>
            <td><%= r.expiry_utc ? new Date(r.expiry_utc).toISOString() : '' %></td>
            <td class="row-actions">
              <a class="btn btn-outline btn-sm" href="/admin/announcements/<%= r.id %>/edit">Edit</a>
              <a class="btn btn-danger btn-sm" href="/admin/announcements/<%= r.id %>/delete">Delete</a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>

    <%- include('./_pagination', { base: '/admin/announcements', page: page, totalPages: totalPages }) %>
  <% } else { %>
    <p class="empty">No announcements yet.</p>
  <% } %>
</section>
